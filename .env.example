# --- Postgres (used by docker-compose and DATABASE_URL below) ---
POSTGRES_USER=recovermem
POSTGRES_PASSWORD=recovermem
POSTGRES_DB=recovermem
POSTGRES_PORT=5433

# --- Backend ---
# Note: host port is 5433, not 5432 -- avoids clashing with a locally
# installed Postgres service that may already own 5432.
DATABASE_URL=postgresql+asyncpg://recovermem:recovermem@localhost:5433/recovermem

# Async engine connection pool -- each request holds a connection for its
# whole lifetime, so the default 5+10 (pool_size+max_overflow) queues under
# any real concurrent load. Tune to the target deployment's concurrency.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Optional: if unset, backend falls back to TemplatedLLMClient (no API key needed)
ANTHROPIC_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Trust decision thresholds (0-100)
TRUST_THRESHOLD_STORE=70
TRUST_THRESHOLD_REVIEW=40

# Rule-scorer additive weights (hand-tuned, not calibrated against labeled
# data -- see app/core/config.py for the relative-magnitude rationale).
TRUST_WEIGHT_SOURCE=30
TRUST_WEIGHT_SIMILARITY=24
TRUST_WEIGHT_NOVELTY_BONUS=24
TRUST_WEIGHT_CONTEXT=18
TRUST_WEIGHT_CONTRADICTION=40
TRUST_WEIGHT_CORROBORATION_PER_MATCH=10
TRUST_WEIGHT_CORROBORATION_CAP=20

# conversation_recency feature decay curve (services/features.py): 1.0 while
# a conversation's gap-since-last-stored-memory is within
# CONVERSATION_RECENCY_FULL_WINDOW_SECONDS, decaying linearly to
# CONVERSATION_RECENCY_FLOOR once the gap reaches
# CONVERSATION_RECENCY_FLOOR_WINDOW_SECONDS.
CONVERSATION_RECENCY_FULL_WINDOW_SECONDS=300
CONVERSATION_RECENCY_FLOOR_WINDOW_SECONDS=86400
CONVERSATION_RECENCY_FLOOR=0.3

# Cosine-similarity floor for recording a dependency_edges "derived_from" link
# to a retrieval hit that wasn't similar enough to be treated as an update to
# the same memory (0-1)
DEPENDENCY_EDGE_SIMILARITY_THRESHOLD=0.3

# Phase 7: minimum REAL (non-synthetic) logged training examples app/ml/
# model.pkl must have been trained on before the RandomForest+SHAP layer is
# allowed to influence trust_score at all -- below this, scoring is 100% the
# Phase 2 rule engine, even if model.pkl exists. The synthetic bootstrap
# dataset doesn't count toward this on its own, so a single
# `python -m app.ml.train` run with no real logged outcomes yet won't
# activate RF blending. Run `python -m app.ml.train` to (re)train.
MIN_TRAINING_SAMPLES=50

# Phase 7: weight given to the rule scorer's own score when blending with the
# RandomForest's 100*P(safe) once MIN_TRAINING_SAMPLES is cleared (0-1, 0.5 =
# equal weight).
RF_BLEND_WEIGHT=0.5

CORS_ORIGINS=http://localhost:5173

# --- Security ---
# Local/demo mode by default (mirrors Django/Flask's DEBUG). Set to false for
# any deployment reachable by anyone other than the operator: it disables the
# attack-simulator endpoints (tamper-db, inject-poison) entirely and requires
# API_KEY to be set, or the backend refuses to start.
DEBUG=true

# Shared-secret API key required via the X-API-Key header on every backend
# route except /health. Optional while DEBUG=true (unset = unauthenticated,
# today's zero-config demo behavior, logged as a warning); required while
# DEBUG=false. If set, also put the same value in frontend/.env.local as
# VITE_API_KEY so the UI can still reach the API.
API_KEY=

# Requests allowed per client (by API key if sent, else by IP) per
# RATE_LIMIT_WINDOW_SECONDS, enforced on every route except /health.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# HMAC key used to sign/verify app/ml/model.pkl before it's unpickled. Unset =
# model.pkl loads without integrity verification (logged as a warning); set
# it (and re-run `python -m app.ml.train` to produce a matching model.pkl.sig)
# to make a tampered/replaced model.pkl fail closed instead of being
# unpickled.
MODEL_SIGNING_KEY=
