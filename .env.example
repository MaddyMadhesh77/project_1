# --- Postgres (used by docker-compose and DATABASE_URL below) ---
POSTGRES_USER=recovermem
POSTGRES_PASSWORD=recovermem
POSTGRES_DB=recovermem
POSTGRES_PORT=5433

# --- Backend ---
# Note: host port is 5433, not 5432 -- avoids clashing with a locally
# installed Postgres service that may already own 5432.
DATABASE_URL=postgresql+asyncpg://recovermem:recovermem@localhost:5433/recovermem

# Optional: if unset, backend falls back to TemplatedLLMClient (no API key needed)
ANTHROPIC_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Trust decision thresholds (0-100)
TRUST_THRESHOLD_STORE=70
TRUST_THRESHOLD_REVIEW=40

CORS_ORIGINS=http://localhost:5173
